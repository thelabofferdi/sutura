# Convex deployment URL exposed to the browser
NEXT_PUBLIC_CONVEX_URL=

# Set automatically by `npx convex dev` or `npx convex deploy`.
# Do not commit secrets or a production deployment value.
CONVEX_DEPLOYMENT=

# Required by convex/auth.config.ts for Convex Auth callbacks
CONVEX_SITE_URL=http://localhost:3000

# Admin allowlist (comma-separated emails) — requis pour /admin
ADMIN_EMAILS=admin@suturamode.com

# Secret de chiffrement des clés IA (Convex env uniquement, jamais Vercel)
AI_KEYS_ENCRYPTION_SECRET=

# Optionnel : fallback env si aucune clé en DB — sinon tout passe par DB chiffrée
IMOLE_API_KEY=
IMOLE_BASE_URL=https://api.imole.app/v1
IMOLE_MODEL=gpt-5.6-luna

# Optionnel : Turnstile anti-bot public (si absent, vérification désactivée)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Requis pour reset mot de passe via Convex Auth + Resend
AUTH_RESEND_KEY=
AUTH_EMAIL=Sutura <onboarding@resend.dev>
